{
  "model": "uer/chinese_roberta_L-8_H-512",
  "train": "data/train.csv",
  "validation": "data/validation.csv",
  "output_dir": "outputs/sweep/fgm",
  "epochs": 5,
  "batch_size": 16,
  "eval_batch_size": 32,
  "grad_accum": 2,
  "max_length": 192,
  "lr": 2e-05,
  "head_lr_multiplier": 5.0,
  "layerwise_lr_decay": 0.92,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "scheduler": "linear",
  "dropout": 0.1,
  "label_smoothing": 0.04,
  "fgm_epsilon": 0.5,
  "rdrop_alpha": 0.0,
  "patience": 2,
  "amp": "auto",
  "seed": 42,
  "num_workers": 0,
  "grad_checkpointing": false,
  "max_grad_norm": 1.0,
  "device": "auto"
}